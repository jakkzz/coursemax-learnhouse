# Native Google release: a separately built, revision-verified web artifact.
# No package downloads, credential copies or migrations during image build.
FROM ghcr.io/learnhouse/app@sha256:0aca30cd7b772bebfb75c8e4e54613ab4391adb2d4e05403992867388169514f
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/jakkzz/coursemax-learnhouse" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
COPY apps/api/src/router.py /app/api/src/router.py
COPY apps/api/src/routers/auth.py apps/api/src/routers/mfa.py apps/api/src/routers/google_subject_auth.py /app/api/src/routers/
COPY apps/api/src/security/auth.py apps/api/src/security/provider_session.py /app/api/src/security/
COPY apps/api/src/services/auth/provider_proof.py \
     apps/api/src/services/auth/oauth_transactions.py \
     apps/api/src/services/auth/provider_identities.py \
     apps/api/src/services/auth/google_handoff.py \
     apps/api/src/services/auth/native_google.py \
     apps/api/src/services/auth/session.py /app/api/src/services/auth/
COPY apps/api/src/db/provider_identity.py apps/api/src/db/users.py /app/api/src/db/
COPY apps/api/migrations/versions/c71a02d9ef40_provider_identity_ownership.py \
     apps/api/migrations/versions/d84e13a6b902_native_google_email_uniqueness.py /app/api/migrations/versions/
RUN rm -rf /app/web
COPY web-runtime/ /app/web/
COPY web-static/static/ /app/web/.next/static/
COPY web-public/public/ /app/web/public/
COPY apps/web/server-wrapper.js /app/web/server-wrapper.js
COPY docker/nginx.conf /etc/nginx/http.d/default.conf
