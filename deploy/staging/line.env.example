# Example LINE fields. Add to existing private runtime/google-oauth.env (0600).
# Preserve existing Google keys; do not replace that file with this example.
# These independent gates remain FALSE until an explicit staging activation.
LEARNHOUSE_LINE_SUBJECT_LOGIN_ENABLED=false
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LEARNHOUSE_LINE_PROVIDER_ID=
LEARNHOUSE_LINE_ORG_ID=1
LEARNHOUSE_LINE_OAUTH_TRANSACTION_SECRET=
LEARNHOUSE_LINE_OAUTH_DEPLOYMENT=learn-staging-line-v1
LEARNHOUSE_LINE_LIFF_ID=
LEARNHOUSE_LINE_LIFF_ENABLED=false
