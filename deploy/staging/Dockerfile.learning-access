# Backend-only overlay over the exact validated native web/auth runtime.
ARG BASE_IMAGE=coursemax-learnhouse:bf4f2908
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
COPY --chown=0:0 --chmod=0600 apps/api/src/route66_ext/adapters/native_learning_access.py /app/api/src/route66_ext/adapters/native_learning_access.py
COPY --chown=0:0 --chmod=0600 apps/api/src/route66_ext/services/learning_access.py /app/api/src/route66_ext/services/learning_access.py
COPY --chown=0:0 --chmod=0600 apps/api/src/route66_ext/services/learning_access_policy.py /app/api/src/route66_ext/services/learning_access_policy.py
COPY --chown=0:0 --chmod=0600 apps/api/src/route66_ext/routers/learning_access.py /app/api/src/route66_ext/routers/learning_access.py
COPY --chown=0:0 --chmod=0600 apps/api/src/route66_ext/services/academic_rosters.py /app/api/src/route66_ext/services/academic_rosters.py
COPY --chown=0:0 --chmod=0600 apps/api/src/route66_ext/routers/academic_classes.py /app/api/src/route66_ext/routers/academic_classes.py
