# LearnHouse environment inventory. Copy to .env (chmod 600) and fill in privately.
# This template contains no deployment credentials. Editing .env does not change a running container.

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LEARNHOUSE_GOOGLE_ORG_ID=
LEARNHOUSE_GOOGLE_SUBJECT_LOGIN_ENABLED=
LEARNHOUSE_GOOGLE_PUBLIC_REGISTRATION_ENABLED=
LEARNHOUSE_GOOGLE_PROFILE_IMPORT_ENABLED=
LEARNHOUSE_GOOGLE_REGISTRATION_EMAILS=[]
LEARNHOUSE_OAUTH_DEPLOYMENT=
LEARNHOUSE_OAUTH_TRANSACTION_SECRET=

# LINE Login and LIFF (attendance uses the same LIFF app)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LEARNHOUSE_LINE_PROVIDER_ID=
LEARNHOUSE_LINE_LIFF_ID=
LEARNHOUSE_LINE_ORG_ID=
LEARNHOUSE_LINE_SUBJECT_LOGIN_ENABLED=
LEARNHOUSE_LINE_LIFF_ENABLED=
LEARNHOUSE_LINE_OAUTH_DEPLOYMENT=
LEARNHOUSE_LINE_OAUTH_TRANSACTION_SECRET=

# Public origins and internal endpoints
LEARNHOUSE_DOMAIN=
LEARNHOUSE_FRONTEND_DOMAIN=
LEARNHOUSE_ALLOWED_ORIGINS=
LEARNHOUSE_ALLOWED_REGEXP=
LEARNHOUSE_SSL=
NEXTAUTH_URL=
NEXT_PUBLIC_COLLAB_URL=
NEXT_PUBLIC_LEARNHOUSE_HTTPS=
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=
NEXT_PUBLIC_LEARNHOUSE_API_URL=
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=
LEARNHOUSE_API_URL=
LEARNHOUSE_INTERNAL_API_URL=
LEARNHOUSE_INTERNAL_BACKEND_URL=

# Storage, sessions and collaboration
LEARNHOUSE_SQL_CONNECTION_STRING=
LEARNHOUSE_REDIS_CONNECTION_STRING=
LEARNHOUSE_REDIS_URL=
LEARNHOUSE_CONTENT_DELIVERY_TYPE=
LEARNHOUSE_AUTH_JWT_SECRET_KEY=
NEXTAUTH_SECRET=
COLLAB_INTERNAL_KEY=
LEARNHOUSE_TENANCY=
LEARNHOUSE_SESSION_COOKIE_TENANCY=
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=

# Organization and initial installation
LEARNHOUSE_INITIAL_ORG_NAME=
LEARNHOUSE_INITIAL_ORG_SLUG=
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=
LEARNHOUSE_INITIAL_ADMIN_EMAIL=
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=

# Application features and workers
LEARNHOUSE_IS_AI_ENABLED=
LEARNHOUSE_LOGFIRE_ENABLED=
LEARNHOUSE_BACKFILL_INTERVAL_HOURS=
LEARNHOUSE_RAG_BACKFILL_HOURS=
LEARNHOUSE_NUDGES_ENABLED=
LEARNHOUSE_HLS_ENABLED=
LEARNHOUSE_DEMO_ENABLED=
LEARNHOUSE_DEVELOPMENT_MODE=
LEARNHOUSE_DISABLE_EE=
LEARNHOUSE_OSS=
NEXT_PUBLIC_LEARNHOUSE_OSS=
LEARNHOUSE_MAX_REQUEST_BODY_MB=

# Container runtime / image-provided values in the release snapshot
HOSTNAME=
PORT=
LEARNHOUSE_PORT=
COLLAB_PORT=
NODE_ENV=
NEXT_TELEMETRY_DISABLED=
PATH=
PYTHONDONTWRITEBYTECODE=
PYTHON_VERSION=
PYTHON_SHA256=
UV_NO_SYNC=
